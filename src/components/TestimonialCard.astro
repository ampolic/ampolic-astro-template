---
interface Props { author: string; role: string; quote: string; rating?: number }
const { author, role, quote } = Astro.props;
---
<figure class="flex h-full flex-col rounded-(--radius-base) border border-line bg-surface p-6 shadow-card">
  <blockquote class="text-lg text-text">“{quote}”</blockquote>
  <figcaption class="mt-6 border-t border-line pt-4">
    <span class="font-mono text-sm uppercase tracking-wide text-text">{author}</span>
    <span class="mt-1 block text-sm text-text-muted">{role}</span>
  </figcaption>
</figure>
