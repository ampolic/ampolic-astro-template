---
import Base from '../layouts/Base.astro';
import { Prose } from '@ampolic/ui';
import { EmailLink } from '@ampolic/ui';
import { site } from '../config/site';

const { legal } = site;
---
<Base
  title="Terms of Use"
  description={`The terms that apply when you use the ${site.name} website.`}
  noindex={false}
>
  <section class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="font-display text-4xl font-semibold">Terms of Use</h1>
      <p class="mt-4 text-text-muted">Effective {legal.effectiveDate}</p>
      <div class="mt-10">
        <Prose>
          <p>
            These terms govern your use of the {legal.businessLegalName} website. By accessing or using
            the site, you agree to them. If you do not agree, please do not use the site.
          </p>

          <h2>Use of the site</h2>
          <p>
            You may use this site for lawful, personal, and informational purposes. You agree not to
            interfere with its normal operation, attempt to gain unauthorized access, or use it in any
            way that could damage, disable, or impair the site or interfere with anyone else&rsquo;s use
            of it.
          </p>

          <h2>Content and no warranty</h2>
          <p>
            The content on this site is provided for general information only. While we try to keep it
            accurate and current, we make no warranties, express or implied, about its completeness,
            accuracy, reliability, or suitability for any purpose. Descriptions of services, pricing,
            and availability may change without notice and do not constitute a binding offer. Nothing on
            this site is professional advice for your specific situation &mdash; contact us directly to
            discuss your needs.
          </p>

          <h2>Intellectual property</h2>
          <p>
            Unless otherwise noted, the content, design, and branding on this site are owned by
            {legal.businessLegalName} or used with permission, and are protected by applicable
            intellectual-property laws. You may not reproduce, distribute, or create derivative works
            from them without our prior written consent.
          </p>

          <h2>Third-party links</h2>
          <p>
            This site may link to third-party websites or services we do not control. We are not
            responsible for their content, policies, or practices, and a link does not imply our
            endorsement.
          </p>

          <h2>Limitation of liability</h2>
          <p>
            To the fullest extent permitted by law, {legal.businessLegalName} is not liable for any
            indirect, incidental, or consequential damages arising from your use of, or inability to
            use, this site.
          </p>

          <h2>Governing law</h2>
          <p>
            These terms are governed by the laws of {legal.jurisdictionNote}, without regard to its
            conflict-of-law rules.
          </p>

          <h2>Changes to these terms</h2>
          <p>
            We may update these terms from time to time. Changes take effect when posted, and the
            effective date above will be revised accordingly.
          </p>

          <h2>Contact</h2>
          <p>
            Questions about these terms? Email
            <EmailLink email={legal.contactEmail} />.
          </p>
        </Prose>
      </div>
    </div>
  </section>
  {/* Template boilerplate — client must review with counsel before publishing. Generic
      shell only; the governing-law clause and every section must be checked against the
      client's jurisdiction and business. Not legal advice. */}
</Base>
