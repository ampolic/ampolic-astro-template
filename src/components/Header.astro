---
import { site } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';
import { Button } from '@ampolic/ui';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-line bg-surface/90 backdrop-blur" style="view-transition-name: site-header">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="font-display text-lg font-semibold">{site.name}</a>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {site.nav.map((i) => (
        <a href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}
           class="rounded-(--radius-base) text-text-muted hover:text-text aria-[current=page]:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">{i.label}</a>
      ))}
      <ThemeToggle />
      <Button href={site.cta.href}>{site.cta.label}</Button>
    </nav>
    <details class="relative md:hidden">
      <summary class="grid size-11 cursor-pointer place-items-center rounded-(--radius-base)" aria-label="Menu">☰</summary>
      <nav class="absolute right-0 mt-2 flex w-48 flex-col gap-1 rounded-(--radius-base) border border-line bg-surface p-2 shadow-card" aria-label="Mobile">
        {site.nav.map((i) => (
          <a href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}
             class="rounded-(--radius-base) px-3 py-2 hover:bg-surface-alt aria-[current=page]:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">{i.label}</a>
        ))}
        <ThemeToggle />
        <Button href={site.cta.href}>{site.cta.label}</Button>
      </nav>
    </details>
  </div>
</header>
