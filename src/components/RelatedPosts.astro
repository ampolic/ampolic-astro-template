---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
interface Props { posts: Post[] }
const { posts } = Astro.props;
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
{
  posts.length > 0 && (
    <section class="mt-16 border-t border-line pt-10">
      <h2 class="font-display text-2xl font-semibold">Keep reading</h2>
      <ul class="mt-6 grid gap-6 sm:grid-cols-3">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}`} class="group block">
              {p.data.cover && (
                <Image
                  src={p.data.cover}
                  alt=""
                  width={384}
                  height={216}
                  loading="lazy"
                  class="aspect-[16/9] w-full rounded-(--radius-base) border border-line object-cover"
                />
              )}
              <p class="mt-3 font-mono text-xs uppercase tracking-[0.12em] text-text-muted">{fmtDate(p.data.date)}</p>
              <h3 class="mt-1 font-display font-semibold group-hover:text-brand">{p.data.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
