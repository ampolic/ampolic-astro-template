---
import Base from '../layouts/Base.astro';
import ContactBlock from '../components/ContactBlock.astro';
import ContactForm from '../components/ContactForm.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
---
<Base title="Contact" description="Get in touch for a quote or service call.">
  <section class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="font-display text-4xl font-semibold">Contact us</h1>
      <div class="mt-10 grid gap-12 lg:grid-cols-2 lg:items-start">
        <div class="space-y-8">
          <ContactBlock />
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.15em] text-brand">Service area</p>
            <div class="mt-4"><ServiceAreaMap /></div>
          </div>
        </div>
        <div><ContactForm /></div>
      </div>
    </div>
  </section>
</Base>
