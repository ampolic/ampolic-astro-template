---
import Button from './Button.astro';
interface Props { heading: string; ctaLabel: string; ctaHref: string; subLabel?: string; phone?: string; phoneLabel?: string }
const { heading, ctaLabel, ctaHref, subLabel, phone, phoneLabel } = Astro.props;
---
<section class="bg-brand text-brand-contrast">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-4 py-(--spacing-section) sm:flex-row sm:items-center sm:justify-between">
    <div>
      {subLabel && <p class="font-mono text-sm uppercase tracking-[0.18em] opacity-80">{subLabel}</p>}
      <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{heading}</h2>
    </div>
    <div class="flex flex-col items-start gap-3 sm:items-end">
      <Button href={ctaHref} variant="inverse">{ctaLabel}</Button>
      {phone && (
        <a href={`tel:${phone}`} class="font-mono text-sm text-brand-contrast underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-contrast">{phoneLabel ?? phone}</a>
      )}
    </div>
  </div>
</section>
