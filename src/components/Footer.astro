---
import { site } from "../config/site";
import { Icon } from "astro-icon/components";
import { EmailLink, PoweredByAmpolic } from "@ampolic/ui";
const year = new Date().getFullYear();
---

<footer class="border-line bg-surface-alt border-t">
  <div
    class="mx-auto grid max-w-6xl gap-10 px-4 py-12 text-center sm:grid-cols-3 sm:text-left"
  >
    <div>
      <img src={site.logo} alt="" class="mx-auto size-10 sm:mx-0" />
      <p class="font-display mt-4 text-lg font-semibold">{site.name}</p>
      <p class="text-text-muted mt-2">{site.tagline}</p>
    </div>
    <div
      class="border-line text-text-muted border-y py-8 sm:border-x sm:border-y-0 sm:px-8 sm:py-0"
    >
      <p>{site.address.street}</p><p>
        {site.address.locality}, {site.address.region}
        {site.address.postalCode}
      </p>
      <p class="mt-3">
        <a href={`tel:${site.phone}`} class="hover:text-text">{site.phone}</a>
      </p>
      <p><EmailLink email={site.email} class="hover:text-text" /></p>
      {
        site.hours.map((h) => (
          <p class="mt-2">
            {h.days}: {h.opens}–{h.closes}
          </p>
        ))
      }
      <p class="mt-3 text-sm">
        <span class="text-text">Serving:</span>
        {site.serviceAreas.join(", ")}
      </p>
    </div>
    <nav
      class="flex flex-col items-center gap-2 sm:items-start"
      aria-label="Footer"
    >
      {
        site.nav.map((item) => (
          <a href={item.href} class="text-text-muted hover:text-text">
            {item.label}
          </a>
        ))
      }
      <div class="mt-2 flex gap-2">
        {
          site.socials.map((social) => (
            <a
              href={social.href}
              aria-label={social.label}
              class="border-line text-text-muted hover:border-brand hover:text-text inline-grid size-10 place-items-center rounded-(--radius-base) border"
            >
              <Icon name={social.icon} class="size-5" />
            </a>
          ))
        }
      </div>
    </nav>
  </div>
  <div class="border-line border-t">
    <div
      class="text-text-muted mx-auto flex max-w-6xl flex-col items-center gap-3 px-4 py-4 text-center text-xs sm:flex-row sm:justify-between sm:text-left"
    >
      <p>© {year} {site.legalName}</p><nav
        class="flex gap-4"
        aria-label="Legal"
      >
        <a href="/privacy" class="hover:text-text">Privacy</a><a
          href="/terms"
          class="hover:text-text">Terms</a
        ><a href="/accessibility" class="hover:text-text">Accessibility</a>
      </nav>{site.credit.enabled && <PoweredByAmpolic href={site.credit.url} />}
    </div>
  </div>
</footer>
