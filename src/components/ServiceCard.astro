---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { title: string; summary: string; icon: string; href: string; index?: string; headingLevel?: 2 | 3; image?: ImageMetadata; imageAlt?: string }
const { title, summary, icon, href, index, headingLevel = 3, image, imageAlt } = Astro.props;
const Heading = `h${headingLevel}` as const;
---
<a href={href} class="group flex h-full flex-col overflow-hidden rounded-(--radius-base) border border-line bg-surface shadow-card transition hover:border-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
  {image && (
    <Image
      src={image}
      alt={imageAlt ?? ''}
      width={600}
      height={400}
      loading="lazy"
      class="aspect-[3/2] w-full border-b border-line object-cover"
    />
  )}
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between">
      <Icon name={icon} class="size-8 text-brand" />
      {index && <span class="font-mono text-sm text-text-muted">{index}</span>}
    </div>
    <Heading class="mt-6 font-display text-xl font-semibold tracking-tight">{title}</Heading>
    <p class="mt-2 text-text-muted">{summary}</p>
    <span class="mt-5 font-mono text-xs uppercase tracking-[0.15em] text-brand opacity-0 transition-opacity group-hover:opacity-100">View service →</span>
  </div>
</a>
