---
import Base from "../layouts/Base.astro";
import ContactBlock from "../components/ContactBlock.astro";
import ContactForm from "../components/ContactForm.astro";
import ContactSplit from "../components/ContactSplit.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";
import { SectionHeading } from "@ampolic/ui";
---

<Base title="Contact" description="Get in touch for a quote or service call.">
  <section class="pt-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4 pb-10">
      <SectionHeading
        eyebrow="Contact"
        heading="A clear next step for your home comfort."
        lede="Tell us what you need and the right person will follow up."
        variant="display"
        rule
      />
    </div>
    <ContactSplit>
      <div slot="details" class="mx-auto max-w-xl">
        <ContactBlock />
        <div class="mt-10">
          <p class="text-brand font-mono text-xs tracking-[0.15em] uppercase">
            Service area
          </p><div class="mt-4"><ServiceAreaMap /></div>
        </div>
      </div>
      <div slot="form" class="mx-auto max-w-xl"><ContactForm /></div>
    </ContactSplit>
  </section>
</Base>
