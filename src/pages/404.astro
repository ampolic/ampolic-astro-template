---
import Base from '../layouts/Base.astro';
import { Button } from '@ampolic/ui';
import { site } from '../config/site';
---
<Base title="Page not found" description="The page you're looking for doesn't exist." noindex>
  <section class="py-(--spacing-section)">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <p class="font-mono text-sm uppercase tracking-[0.18em] text-brand">Error 404</p>
      <p class="mt-4 font-display text-7xl font-semibold tracking-tight sm:text-8xl" aria-hidden="true">404</p>
      <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">Page not found</h1>
      <p class="mx-auto mt-5 max-w-md text-lg text-text-muted">
        This page moved or never existed. Here's the way back:
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/services" variant="outline">Services</Button>
        <Button href="/blog" variant="outline">Blog</Button>
        <Button href="/contact" variant="solid">Contact</Button>
      </div>
      <p class="mt-8 font-mono text-sm uppercase tracking-[0.12em] text-text-muted">
        Or call us —
        <a href={`tel:${site.phone}`}
           class="text-brand underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">{site.phone}</a>
      </p>
    </div>
  </section>
</Base>
