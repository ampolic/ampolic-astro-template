---
import { Icon } from 'astro-icon/components';
interface Props { title: string; summary: string; icon: string; href: string; index?: string }
const { title, summary, icon, href, index } = Astro.props;
---
<a href={href} class="group flex h-full flex-col rounded-(--radius-base) border border-line bg-surface p-6 shadow-card transition hover:border-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
  <div class="flex items-start justify-between">
    <Icon name={icon} class="size-8 text-brand" />
    {index && <span class="font-mono text-sm text-text-muted">{index}</span>}
  </div>
  <h3 class="mt-6 font-display text-xl font-semibold tracking-tight">{title}</h3>
  <p class="mt-2 text-text-muted">{summary}</p>
  <span class="mt-5 font-mono text-xs uppercase tracking-[0.15em] text-brand opacity-0 transition-opacity group-hover:opacity-100">View service →</span>
</a>
