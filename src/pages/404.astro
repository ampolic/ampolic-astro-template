---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Page not found" description="The page you're looking for doesn't exist." noindex>
  <section class="py-(--spacing-section)">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h1 class="font-display text-4xl font-semibold">Page not found</h1>
      <p class="mt-5 text-lg text-text-muted">
        We couldn't find that page. It may have moved, or it might never have existed.
      </p>
      <div class="mt-8">
        <Button href="/" variant="solid">Back to home</Button>
      </div>
    </div>
  </section>
</Base>
