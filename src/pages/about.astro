---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Prose from '../components/Prose.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import aboutImage from '../assets/images/about-technician.webp';

const faqEntries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const faqItems = await Promise.all(
  faqEntries.map(async (f) => ({ question: f.data.question, Content: (await render(f)).Content }))
);
---
<Base
  title="About us"
  description="Summit Heating & Air has kept Boulder-area homes comfortable since 2009. Licensed, local, and straight with you."
>
  <section class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="font-display text-4xl font-semibold text-balance sm:text-5xl">About Summit Heating & Air</h1>
      <p class="mt-5 max-w-[52ch] text-lg text-text-muted">
        A family-owned HVAC company built on straight answers and work we stand behind.
      </p>
    </div>
  </section>
  <section class="bg-surface-alt py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <Image
        src={aboutImage}
        alt="A Summit technician rebuilding a pump assembly at the shop workbench"
        widths={[768, 1280, 1600]}
        sizes="(min-width: 72rem) 72rem, 100vw"
        loading="lazy"
        class="mb-12 aspect-[16/9] w-full rounded-(--radius-base) border border-line object-cover"
      />
      <SectionHeading eyebrow="Our story" heading="Sixteen years of Boulder winters and summers" />
      <Prose>
        <p>
          Summit Heating & Air started in 2009 with one truck, one technician, and a simple rule: tell
          people the truth about what their system needs, then do the work right the first time. Our
          founder had spent a decade installing furnaces for a national chain, and left when he got
          tired of chasing upsell quotas. Summit was his way of doing the job differently.
        </p>
        <p>
          Boulder's climate doesn't make the work easy. Triple-digit summer afternoons give way to
          winter nights well below freezing, sometimes only a few months apart. That range shapes how
          we size equipment: we account for the elevation and the swings of the Front Range instead of
          a generic spec sheet, and we back every repair and install with a written workmanship warranty.
        </p>
        <h2>What hasn't changed</h2>
        <p>
          We're still locally owned, still licensed and insured in Boulder County, and still small
          enough that whoever answers your call knows the technician heading to your door. Estimates
          are free, every price gets explained before we start, and we don't charge for a diagnosis
          when we can't fix the problem on the same visit.
        </p>
        <h2>Where we're headed</h2>
        <p>
          Today our certified crew handles AC repair and installation, furnace and heat pump service,
          and indoor air quality for homes across the greater Boulder area. We run more trucks than we
          used to, but the promise is the same: honest quotes, no surprises, and a house that stays
          comfortable all year.
        </p>
      </Prose>
    </div>
  </section>
  <section class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <SectionHeading eyebrow="FAQ" heading="Common questions" />
      <FaqList items={faqItems} />
    </div>
  </section>
  <CtaBand heading="Ready to work with a crew you can trust?" ctaLabel="Get a quote" ctaHref="/contact" />
</Base>
