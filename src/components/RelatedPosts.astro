---
import { Image } from "astro:assets";
import type { Post } from "../lib/posts";
import { resolveContentImage } from "../lib/contentImage";
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

{
  posts.length > 0 && (
    <section class="border-line mt-16 border-t pt-10">
      <h2 class="font-display text-2xl font-semibold">Keep reading</h2>
      <ul class="mt-6 grid gap-6 sm:grid-cols-3">
        {posts.map((p) => {
          const cover = resolveContentImage(p.data.cover, `posts/${p.id}`);
          return (
            <li>
              <a href={`/blog/${p.id}`} class="group block">
                {cover && (
                  <Image
                    src={cover}
                    alt=""
                    width={384}
                    height={216}
                    loading="lazy"
                    class="border-line aspect-[16/9] w-full rounded-(--radius-base) border object-cover"
                  />
                )}
                <p class="text-text-muted mt-3 font-mono text-xs tracking-[0.12em] uppercase">
                  {fmtDate(p.data.date)}
                </p>
                <h3 class="font-display group-hover:text-brand mt-1 font-semibold">
                  {p.data.title}
                </h3>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
