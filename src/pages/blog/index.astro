---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, getAllTags } from '../../lib/posts';
import PostRow from '../../components/PostRow.astro';
import TagList from '../../components/TagList.astro';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---
<Base title="Blog" description="Tips and guides from our team.">
  <section class="py-(--spacing-section)">
    <div class="mx-auto max-w-3xl px-4">
      <h1 class="font-display text-4xl font-semibold">Blog</h1>
      {
        tags.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <span class="font-mono text-xs uppercase tracking-[0.12em] text-text-muted">Browse by tag</span>
            <TagList tags={tags.map((t) => t.tag)} />
          </div>
        )
      }
      <ul class="mt-10 space-y-8">
        {posts.map((p) => (
          <li>
            <PostRow post={p} />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
