---
import type { Post } from '../lib/posts';
interface Props { prev: Post | null; next: Post | null }
const { prev, next } = Astro.props;
---
{
  (prev || next) && (
    <nav class="mt-12 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
      {prev ? (
        <a
          href={`/blog/${prev.id}`}
          class="group rounded-(--radius-base) border border-line p-4 transition-colors hover:border-brand"
        >
          <span class="font-mono text-xs uppercase tracking-[0.12em] text-text-muted">← Newer</span>
          <span class="mt-1 block font-display font-semibold group-hover:text-brand">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a
          href={`/blog/${next.id}`}
          class="group rounded-(--radius-base) border border-line p-4 text-right transition-colors hover:border-brand sm:col-start-2"
        >
          <span class="font-mono text-xs uppercase tracking-[0.12em] text-text-muted">Older →</span>
          <span class="mt-1 block font-display font-semibold group-hover:text-brand">{next.data.title}</span>
        </a>
      )}
    </nav>
  )
}
