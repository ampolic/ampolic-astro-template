---
interface Props { eyebrow?: string; heading: string; lede?: string }
const { eyebrow, heading, lede } = Astro.props;
---
<div class="max-w-2xl">
  {eyebrow && <p class="font-mono text-sm uppercase tracking-[0.18em] text-brand">{eyebrow}</p>}
  <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{heading}</h2>
  {lede && <p class="mt-4 text-lg text-text-muted">{lede}</p>}
</div>
