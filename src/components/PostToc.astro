---
/* Sticky left-gutter table of contents for long posts. Built from the post's
   markdown headings. Progressive enhancement: without JS it's a plain list of
   in-page anchor links; the script adds a reading-progress rail, scroll-spy
   highlighting, and a live "time remaining" readout, and motion.ts routes clicks
   through Lenis for a smooth jump. */
import { Icon } from 'astro-icon/components';
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  words: number;
  minutes: number;
  class?: string;
}
const { headings, words, minutes, class: className } = Astro.props;
---
<nav data-toc data-words={words} aria-label="On this page" class:list={[className]}>
  <p class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-text-muted">On this page</p>
  <div class="relative mt-4 pl-5">
    <span class="absolute inset-y-1 left-0 w-px bg-line" aria-hidden="true"></span>
    <span
      data-toc-progress
      style="transform:scaleY(0)"
      class="absolute inset-y-1 left-0 w-px origin-top bg-brand"
      aria-hidden="true"></span>
    <ul class="space-y-3.5">
      {headings.map((h, i) => (
        <li>
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            class:list={[
              'group flex items-baseline gap-2.5 text-sm leading-snug text-text-muted transition-colors hover:text-text data-[active]:text-brand',
              h.depth >= 3 && 'pl-4',
            ]}
          >
            <span class="font-mono text-[0.7rem] tabular-nums text-text-muted transition-colors group-data-[active]:text-brand">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span>{h.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <p class="mt-6 flex items-center gap-2 border-t border-line pt-4 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-text-muted">
    <Icon name="lucide:clock" class="size-3.5 shrink-0 text-brand" />
    <span data-toc-remaining>{minutes} min left</span>
  </p>
</nav>

<script>
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const article = document.querySelector<HTMLElement>('article');
  if (toc && article) {
    const progress = toc.querySelector<HTMLElement>('[data-toc-progress]');
    const remainingEl = toc.querySelector<HTMLElement>('[data-toc-remaining]');
    const totalMinutes = Number(toc.dataset.words) / 200;
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[data-toc-link]'));
    const targets = links
      .map((a) => document.getElementById(a.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => el !== null);
    let ticking = false;
    const update = () => {
      ticking = false;
      // Reading progress: 0 when the article top reaches the viewport top, 1 at the bottom.
      const rect = article.getBoundingClientRect();
      const top = rect.top + window.scrollY;
      const span = rect.height - window.innerHeight;
      const pct = span > 0 ? Math.min(1, Math.max(0, (window.scrollY - top) / span)) : 0;
      if (progress) progress.style.transform = `scaleY(${pct})`;
      // Time remaining: total reading time scaled by how much is left below the fold.
      if (remainingEl) {
        const rem = totalMinutes * (1 - pct);
        remainingEl.textContent =
          pct >= 0.999 ? 'Finished' : rem < 1 ? 'Less than a min left' : `${Math.round(rem)} min left`;
      }
      // Scroll-spy: the last heading whose top has passed the offset line is active.
      let activeId = targets[0]?.id;
      for (const t of targets) {
        if (t.getBoundingClientRect().top <= 140) activeId = t.id;
        else break;
      }
      for (const a of links) {
        if (a.dataset.tocLink === activeId) a.setAttribute('data-active', '');
        else a.removeAttribute('data-active');
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
