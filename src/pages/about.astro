---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import {
  Button,
  Card,
  CtaBand,
  FaqList,
  Prose,
  SectionHeading,
} from "@ampolic/ui";
import { Icon } from "astro-icon/components";
import { site } from "../config/site";
import aboutImage from "../assets/images/about-technician.webp";

const faqEntries = (await getCollection("faq")).sort(
  (a, b) => a.data.order - b.data.order,
);
const faqItems = await Promise.all(
  faqEntries.map(async (f) => ({
    question: f.data.question,
    icon: f.data.icon,
    Content: (await render(f)).Content,
  })),
);

// E-E-A-T slots: owner identity, years in business, licenses/certifications.
const { owner, licenses, certifications } = site.credentials;
const years = new Date().getFullYear() - site.trust.established;
const ownerInitials = owner.name
  .split(" ")
  .map((p) => p[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
const credentials = [...licenses, ...certifications];
---

<Base
  title="About us"
  description="Summit Heating & Air has kept Boulder-area homes comfortable since 2009. Licensed, local, and straight with you."
>
  <section class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="font-display text-4xl font-semibold text-balance sm:text-5xl">
        About Summit Heating & Air
      </h1>
      <p class="text-text-muted mt-5 max-w-[52ch] text-lg">
        A family-owned HVAC company built on straight answers and work we stand
        behind.
      </p>
    </div>
  </section>
  <section class="bg-surface-alt py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <Image
        src={aboutImage}
        alt="A Summit technician rebuilding a pump assembly at the shop workbench"
        widths={[768, 1280, 1600]}
        sizes="(min-width: 72rem) 72rem, 100vw"
        loading="lazy"
        class="border-line mb-12 aspect-[16/9] w-full rounded-(--radius-base) border object-cover"
      />
      <SectionHeading
        eyebrow="Our story"
        heading="Sixteen years of Boulder winters and summers"
      />
      <Prose>
        <p>
          Summit Heating & Air started in 2009 with one truck, one technician,
          and a simple rule: tell people the truth about what their system
          needs, then do the work right the first time. Our founder had spent a
          decade installing furnaces for a national chain, and left when he got
          tired of chasing upsell quotas. Summit was his way of doing the job
          differently.
        </p>
        <p>
          Boulder's climate doesn't make the work easy. Triple-digit summer
          afternoons give way to winter nights well below freezing, sometimes
          only a few months apart. That range shapes how we size equipment: we
          account for the elevation and the swings of the Front Range instead of
          a generic spec sheet, and we back every repair and install with a
          written workmanship warranty.
        </p>
        <h2>What hasn't changed</h2>
        <p>
          We're still locally owned, still licensed and insured in Boulder
          County, and still small enough that whoever answers your call knows
          the technician heading to your door. Estimates are free, every price
          gets explained before we start, and we don't charge for a diagnosis
          when we can't fix the problem on the same visit.
        </p>
        <h2>Where we're headed</h2>
        <p>
          Today our certified crew handles AC repair and installation, furnace
          and heat pump service, and indoor air quality for homes across the
          greater Boulder area. We run more trucks than we used to, but the
          promise is the same: honest quotes, no surprises, and a house that
          stays comfortable all year.
        </p>
      </Prose>
    </div>
  </section>
  <section class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <SectionHeading
        eyebrow="Who you're hiring"
        heading="Ownership & credentials"
      />
      <div class="mt-12 grid gap-10 md:grid-cols-2 md:items-start">
        <!-- Owner slot: photo (or initials fallback) + name + title -->
        <div class="flex items-center gap-5">
          {
            owner.photo ? (
              <img
                src={owner.photo}
                alt={`${owner.name}, ${owner.title}`}
                width="80"
                height="80"
                class="border-line size-20 shrink-0 rounded-full border object-cover"
              />
            ) : (
              <span
                aria-hidden="true"
                class="border-line bg-surface-alt font-display text-brand grid size-20 shrink-0 place-items-center rounded-full border text-2xl font-semibold"
              >
                {ownerInitials}
              </span>
            )
          }
          <div>
            <p class="font-display text-xl font-semibold">{owner.name}</p>
            <p class="text-text-muted">{owner.title}</p>
            <p
              class="text-text-muted mt-1 font-mono text-xs tracking-[0.12em] uppercase"
            >
              {years} years in business · Est. {site.trust.established}
            </p>
          </div>
        </div>
        <!-- Licenses & certifications slot -->
        {
          credentials.length > 0 && (
            <div>
              <p class="text-brand font-mono text-xs tracking-[0.15em] uppercase">
                Licenses & certifications
              </p>
              <ul class="text-text-muted mt-4 space-y-2">
                {credentials.map((c) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="text-brand">
                      ✓
                    </span>
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>
  <section class="bg-surface-alt py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <div
        class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-14"
      >
        <div class="space-y-8" data-reveal>
          <SectionHeading
            eyebrow="FAQ"
            heading="Common questions"
            lede="What Boulder homeowners ask before booking. If your question is not here, our team is happy to help."
          />
          <Card>
            <span
              class="bg-brand/10 text-brand flex size-12 items-center justify-center rounded-full"
              aria-hidden="true"
            >
              <Icon name="lucide:message-circle-question" class="size-6" />
            </span>
            <h3 class="font-display mt-4 text-xl font-semibold">
              Still have questions?
            </h3>
            <p class="text-text-muted mt-2">
              Talk directly with our local dispatch team.
            </p>
            <div class="mt-5">
              <Button href="/contact">Ask the Summit team</Button>
            </div>
          </Card>
        </div>
        <div data-reveal><FaqList items={faqItems} /></div>
      </div>
      <ul
        class="mt-14 grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4"
        data-stagger
      >
        {
          [
            {
              icon: "lucide:badge-check",
              title: "Licensed",
              sub: "Colorado contractor",
            },
            {
              icon: "lucide:receipt-text",
              title: "Clear pricing",
              sub: "Approved before work",
            },
            {
              icon: "lucide:clock-3",
              title: "24/7 dispatch",
              sub: "Emergency response",
            },
            {
              icon: "lucide:map-pin",
              title: "Locally owned",
              sub: "Based in Boulder",
            },
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span
                class="bg-brand/10 text-brand flex size-10 shrink-0 items-center justify-center rounded-full"
                aria-hidden="true"
              >
                <Icon name={item.icon} class="size-5" />
              </span>
              <div>
                <p class="font-medium">{item.title}</p>
                <p class="text-text-muted text-sm">{item.sub}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <CtaBand
    heading="Ready to work with a crew you can trust?"
    ctaLabel="Get a quote"
    ctaHref="/contact"
  />
</Base>
